BINANCE_API_KEY=
BINANCE_API_SECRET=

PAPER_MODE=true
PAPER_BALANCE_USDT=1000
INITIAL_CAPITAL=1000
MAX_MARGIN_FRACTION=0.10
FEE_RATE=0.0005
SLIPPAGE_RATE=0.0002
LEVERAGE_CANDIDATES=1,2,3,5,10
BINANCE_SSL_VERIFY=false

# Champion entry TF (15m) + HTF bias filters
TIMEFRAME_MAIN=15m
TIMEFRAME_MID=1h
TIMEFRAME_TREND=4h
TIMEFRAME_HTF=1d
# 15m: default 180d (~17k bars). Tăng nếu máy/research chịu nổi.
HISTORY_DAYS=180
POPULATION_SIZE=36
GENERATIONS=12
RESEARCH_EVERY_HOURS=24
PAPER_POLL_SECONDS=20
# Soft promote when no hard-qualify (paper learning)
PAPER_SOFT_PROMOTE=true
SOFT_MIN_VALIDATION_TRADES=6
SOFT_MIN_TEST_TRADES=4
SOFT_MIN_PROFIT_FACTOR=1.0
# Soft entry OFF: học bằng tick_history → research đổi genome (không nới filter live)
PAPER_SOFT_ENTRY=false
PAPER_SOFT_VOLUME_CAP=1.1
PAPER_SOFT_MAX_ATR_FLOOR=0.04
TICK_HISTORY_MAX=80
STARVE_MIN_TICKS=16
STARVE_SKIP_RATIO=0.85
STARVE_TRIGGER_RESEARCH=true
STARVE_COOLDOWN_HOURS=6
# Strategy Spec (catalog indicators) — PnL-first
SPEC_PATCH_MIN_TRADES=12
SPEC_REPLACE_MIN_TRADES=20
SPEC_PATCH_COOLDOWN_HOURS=6
LLM_RESEARCH_ENABLED=true
ARCHIVE_LEARN_STATE_ON_START=true
REPLAY_ON_START=false

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backup Champion/paper/tick qua GitHub (branch history-data) — cần cho Blitz rebuild
HISTORY_GITHUB_TOKEN=
HISTORY_GITHUB_REPO=chinhdd96/btc-dow-pa-agent
HISTORY_GITHUB_BRANCH=history-data
CHAMPION_GITHUB_PATH=generated/champion_snapshot.json
